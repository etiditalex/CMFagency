# =============================================================================
# M-Pesa B2C Proxy URLs (from Safaricom - add your production values in Vercel)
# =============================================================================
# Copy these variable names to Vercel → Settings → Environment Variables
# and paste the URL values you received from Safaricom for each proxy.
#
# Proxy:B2C              → MPESA_B2C_URL
# Proxy:TransactionStatus → MPESA_TRANSACTION_STATUS_URL
# Proxy:AccountBalance   → MPESA_ACCOUNT_BALANCE_URL
# =============================================================================

MPESA_B2C_URL=
MPESA_TRANSACTION_STATUS_URL=
MPESA_ACCOUNT_BALANCE_URL=

# =============================================================================
# Resend – receipt emails for M-Pesa STK (tickets/votes) and Paystack
# =============================================================================
# Get API key at https://resend.com/api-keys
#
# To send to ANY recipient (not just your account email):
# 1. Verify your domain at https://resend.com/domains
# 2. Set RESEND_FROM_EMAIL to an address on that domain, e.g.:
#    RESEND_FROM_EMAIL=CMF Agency <noreply@yourdomain.com>
# If RESEND_FROM_EMAIL is unset, Resend only allows sending to your own email.
#
# Optional: use Resend SMTP (Resend dashboard → SMTP)
# https://resend.com/docs/send-with-smtp
# - Host: smtp.resend.com | User: resend | Password: your API key
# - Set RESEND_USE_SMTP=true to send via SMTP instead of Resend API.
# - RESEND_SMTP_PORT=465 (default, SMTPS) or 587 (STARTTLS)
# =============================================================================

RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Optional: https URL for transactional email header logo (default: Changer Fusions on Cloudinary)
# RESEND_EMAIL_LOGO_URL=
RESEND_USE_SMTP=
RESEND_SMTP_PORT=

# =============================================================================
# Research Hub (public /research page – Tavily + OpenAI)
# =============================================================================
# Tavily: get API key at https://tavily.com (same key as in MCP URL, e.g.
# from https://mcp.tavily.com/mcp/?tavilyApiKey=YOUR_KEY — use only YOUR_KEY).
# OpenAI: OPENAI_API_KEY is used to summarize results; ensure it is set.
# =============================================================================

TAVILY_API_KEY=
OPENAI_API_KEY=

# =============================================================================
# Job board aggregator (Remote OK, Remotive, Jobicy, optional Adzuna)
# =============================================================================
# Run SQL: database/ticketing_voting_mvp_patch_60_aggregated_external_jobs.sql
#
# Sync: GET or POST /api/internal/job-aggregate/sync with Authorization: Bearer <CRON_SECRET or JOB_AGGREGATE_SYNC_SECRET>.
# On Vercel Pro+, you may add a cron in vercel.json (path + schedule). Hobby: use GitHub Actions, cron-job.org, or manual curl:
#   curl -H "Authorization: Bearer $CRON_SECRET" https://YOUR_DOMAIN/api/internal/job-aggregate/sync
#
# Optional: JOB_AGGREGATE_SYNC_SECRET as alternate bearer (either secret works).
#
# Adzuna (https://developer.adzuna.com/) — without keys, Adzuna is skipped.
# ADZUNA_COUNTRY: e.g. ke, gb, us
# =============================================================================

CRON_SECRET=
JOB_AGGREGATE_SYNC_SECRET=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=ke
